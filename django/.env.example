# PostgreSQL read-only reporting account
PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=your_database
PGUSER=your_readonly_user
PGPASSWORD=replace_with_your_password
# Uncomment if required by the database server.
# PGSSLMODE=require
# Calendar-day boundaries for report queries. Defaults to Asia/Hong_Kong.
# REPORTING_TIMEZONE=Asia/Hong_Kong
