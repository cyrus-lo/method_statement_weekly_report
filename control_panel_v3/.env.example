CONTROL_PANEL_V3_ECM_OUTPUT_DIR=control_panel_v3/working/ecm
CONTROL_PANEL_V3_SMM_OUTPUT_DIR=control_panel_v3/working/smm
CONTROL_PANEL_V3_DJANGO_OUTPUT_DIR=control_panel_v3/working/django
