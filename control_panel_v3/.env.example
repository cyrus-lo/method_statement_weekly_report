# V3-only settings. Writable paths must stay under control_panel_v3/.
CONTROL_PANEL_V3_HOST=127.0.0.1
CONTROL_PANEL_V3_PORT=8767
CONTROL_PANEL_V3_PREVIEW_ONLY=true
CONTROL_PANEL_V3_DATA_DIR=control_panel_v3/data
CONTROL_PANEL_V3_ARCHIVE_DIR=control_panel_v3/archive
CONTROL_PANEL_V3_CSV_DIR=control_panel_v3/working/csv
CONTROL_PANEL_V3_ECM_OUTPUT_DIR=control_panel_v3/working/ecm
CONTROL_PANEL_V3_SMM_OUTPUT_DIR=control_panel_v3/working/smm
CONTROL_PANEL_V3_DJANGO_OUTPUT_DIR=control_panel_v3/working/django
CONTROL_PANEL_V3_ECM_TEMPLATE=control_panel_v3/working/templates/ECM_Record_template.xlsx
CONTROL_PANEL_V3_SMM_TEMPLATE=control_panel_v3/working/templates/SMM_KMS_PM_Master_Document_template.xlsx
CONTROL_PANEL_V3_READINESS_WORKBOOK=control_panel_v3/working/readiness/SMM_KMS_PM_Master_Document.xlsx
CONTROL_PANEL_V3_WEEKLY_TEMPLATE=control_panel_v3/working/templates/Method_Statement_Interaction_Weekly_Report_template.xlsx
CONTROL_PANEL_V3_SUMMARY_LAYOUT_SHEET=(WIP) 1 Jul - 12 Jul
CONTROL_PANEL_V3_EDGE_PROFILE_DIR=control_panel_v3/edge-profile
# Opt-in: back up the V3 Edge profile to a timestamped sibling before creating a fresh one.
CONTROL_PANEL_V3_RESET_EDGE_PROFILE=false
CONTROL_PANEL_V3_JOB_TIMEOUT_SECONDS=7200
# Step 0's operation, authentication and failure-hold waits are separate.
# The job timeout must exceed their sum; multiple operations may need more time.
CONTROL_PANEL_V3_STEP0_HEADED=true
CONTROL_PANEL_V3_STEP0_LOGIN_IF_NEEDED=true
CONTROL_PANEL_V3_STEP0_TIMEOUT_SECONDS=60
CONTROL_PANEL_V3_STEP0_AUTH_TIMEOUT_SECONDS=120
CONTROL_PANEL_V3_STEP0_FAILURE_BROWSER_HOLD_SECONDS=120
CONTROL_PANEL_V3_WORKER_TIMEOUT_SECONDS=180
CONTROL_PANEL_V3_EXCEL_FILTER_TIMEOUT_SECONDS=90
CONTROL_PANEL_V3_ECM_URL=https://ecm.chunwo.com/navigator/
