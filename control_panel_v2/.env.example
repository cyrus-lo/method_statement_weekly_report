# V2 is deliberately separate from V1 and starts read-only.
CONTROL_PANEL_V2_DATA_DIR=control_panel_v2/data
CONTROL_PANEL_V2_PREVIEW_ONLY=true

# Workflow locations. Defaults match this repository.
DJANGO_PYTHON=django/.venv/Scripts/python.exe
ECM_PYTHON=ecm/.venv/Scripts/python.exe
STEP0_PYTHON=ecm/step0_worker/.venv/Scripts/python.exe
ECM_BASE_URL=https://ecm.chunwo.com/navigator/
STEP0_EDGE_PROFILE_DIR=control_panel_v2/.step0-edge-profile
STEP0_TIMEOUT_SECONDS=60
STEP0_AUTH_TIMEOUT_SECONDS=120
STEP0_LOGIN_IF_NEEDED=true
# Development diagnostics: keep the dedicated Edge browser visible.
STEP0_HEADED=true
# Retain a failed visible browser for up to 2 minutes.
STEP0_FAILURE_BROWSER_HOLD_SECONDS=120
# One-shot recovery only: back up the current profile and create a fresh one.
STEP0_RESET_PROFILE=false
DJANGO_TEMPLATE=django/Method_Statement_Interaction_Weekly_Report_template.xlsx
DJANGO_OUTPUT_DIR=django/output
ECM_CSV_DIR=ecm/csv_from_ecm
ECM_TEMPLATE=ecm/ECM_Record_template.xlsx
ECM_RECORD=ecm/output/ECM_Record.xlsx
SMM_TEMPLATE=ecm/SMM_KMS_PM_Master_Document_template.xlsx
SMM_RECORD=ecm/output/SMM_KMS_PM_Master_Document.xlsx
SMM_SUMMARY_TEMPLATE_SHEET=(OK) 1 Jul - 12 Jul
JOB_TIMEOUT_SECONDS=7200
